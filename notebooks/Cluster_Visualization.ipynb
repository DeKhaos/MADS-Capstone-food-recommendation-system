false, \"FSA_binary\": true, \"FSA_binned\": 3, \"popularity_log\": 0.0, \"cluster\": \"0\", \"pca1\": -0.78396301429005, \"pca2\": -0.539549187041281, \"protein_kcal\": 54.4, \"fat_kcal\": 108.0, \"carb_kcal\": 34.0, \"protein_pct\": 27.698574338085542, \"fat_pct\": 54.989816700610994, \"net_carb_pct\": 17.311608961303463, \"satiety_score_raw\": 26.961841283976565, \"satiety\": 23.970383887699498, \"nutrient_density_raw\": 7.1629928595550485, \"nutrient_density\": 43.519527602042736}, {\"RecipeId\": 93966, \"Name\": \"Duck Breasts With Cherry Port Sauce\", \"RecipeInstructions\": \"['In a small saucepan heat the port over moderate heat until it is hot; add the cherries, cover the pot and let the mixture stand for 15 minutes.', 'Score the skin of the duck in a crosshatch pattern and season both sides of the duck with salt and pepper.', 'Heat a medium saute pan over high heat until it is very hot.', 'Add the duck, skin-side down and reduce the heat to moderately-low.', 'Cook the duck for 6 to 8 minutes, pouring off the accumulated fat.', 'Transfer the duck to a small roasting pan and roast it for 10 minutes at 400\\u00b0F (for medium-rare); let the duck stand for 10 minutes before slicing.', 'While the duck is roasting, pour off all but 2 tablespoons of duck fat from the saute pan.', 'Add the shallots and saute over moderately-high heat until softened.', 'Add the rhubarb and saute for 4 minutes; add the sugar snap peas and saute for an additional 1 to 2 minutes.', 'Transfer the rhubarb/pea mixture to a bowl and stir in one tablespoon of honey.', 'Add the cherry/port mixture to the saute pan and let it simmer for 1 minute.', 'Add the chicken broth/stock and simmer until reduced by one third.', 'Whisk together the arrowroot with the orange juice, add the mixture to the sauce and then let it come to a boil; add the remaining 1 tablespoon honey, 1/8 teaspoon black pepper, and salt to taste.', 'Divide the rhubarb/snap pea mixture among 4 plates.', 'Slice the duck at an angle and divide it among the 4 plates (arrange on top of the rhubarb/peas), then drizzle all with the sauce.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 640.1, \"FatContent\": 27.1, \"SaturatedFatContent\": 7.3, \"CholesterolContent\": 326.4, \"SodiumContent\": 591.0, \"CarbohydrateContent\": 26.2, \"FiberContent\": 3.2, \"SugarContent\": 15.0, \"ProteinContent\": 63.4, \"source\": \"foodcom\", \"PrepTime\": \"PT45M\", \"CookTime\": null, \"TotalTime\": \"PT45M\", \"PrepTime_Minutes\": 45.0, \"CookTime_Minutes\": null, \"TotalTime_Minutes\": 45.0, \"RecipeIngredientParts\": \"['port wine', 'dried tart cherry', 'duck breasts', 'shallot', 'fresh rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'fresh coarse ground black pepper', 'salt']\", \"RecipeIngredientParts_old\": \"['port wine', 'dried tart cherry', 'duck breasts', 'shallot', 'fresh rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'fresh coarse ground black pepper', 'salt']\", \"ingredients_canonical\": \"['port wine', 'tart cherry', 'duck breast', 'shallot', 'rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'coarse black pepper', 'salt']\", \"ingredients_canonical_auto\": \"['port wine', 'tart cherry', 'chicken breast', 'shallot', 'rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'coarse black pepper', 'salt']\", \"ingredients_canonical_final\": \"['port wine', 'tart cherry', 'chicken breast', 'shallot', 'rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'coarse black pepper', 'salt']\", \"ingredients_canonical_final_le_5_replace\": \"['port wine', 'tart cherry', 'chicken breast', 'shallot', 'rhubarb', 'sugar snap pea', 'chicken broth', 'arrowroot', 'honey', 'coarse black pepper', 'salt']\", \"EnergyFromFat\": 243.9, \"EnergyFromSaturatedFat\": 65.7, \"EnergyFromCarbs\": 104.8, \"EnergyFromProtein\": 253.6, \"SaturatedFatPercentEnergy\": 10.264021246680208, \"FatPercentEnergy\"
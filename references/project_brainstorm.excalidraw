    {
      "id": "SZpBW6GvKkDJ8YlhcfB5u",
      "type": "text",
      "x": 9547.301436766436,
      "y": -3818.0311447022477,
      "width": 850.901611328125,
      "height": 1347.4485945778679,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,

e\": 7, \"FSA_Healthy\": false, \"popularity_score\": 40.0, \"ID\": \"244652_foodcom\", \"WHO_binary\": true, \"FSA_binary\": false, \"FSA_binned\": 1, \"popularity_log\": 3.713572066704308, \"cluster\": \"0\", \"pca1\": -0.8516517353182049, \"pca2\": 0.20597298781682116, \"protein_kcal\": 27.2, \"fat_kcal\": 61.199999999999996, \"carb_kcal\": 194.8, \"protein_pct\": 9.6045197740113, \"fat_pct\": 21.610169491525426, \"net_carb_pct\": 68.78531073446328, \"satiety_score_raw\": 5.044248169315074, \"satiety\": 13.398977185913722, \"nutrient_density_raw\": 1.2124621311112729, \"nutrient_density\": 37.45326387588954}, {\"RecipeId\": 318092, \"Name\": \"Turkey Meatloaf With Creamy Asiago Gravy, Roasted Broccoli &amp;\", \"RecipeInstructions\": \"['Preheat oven to 425\\u00b0F', 'Cut the top off the whole garlic bulb, drizzle with EVOO and rub into skin. Double wrap the garlic in foil and roast 20-25 minutes in the oven or toaster oven.', 'While the garlic is roasting, place the bread into medium size mixing bowl and pour the milk over it. Let it soak for 5-10 minutes.', 'In another medium-size mixing bowl, add the ground turkey. Make a deep well in the center by punching the meat with your fist and fill it with the 2 cloves of grated garlic, soaked bread, poultry seasoning, sage, nutmeg, shallots, Parmigiano-Reggiano and egg.', 'Mix the meatloaf ingredients together, form a long, thin, oval-shaped loaf and transfer it to a sheet pan. Drizzle the loaf liberally with EVOO, and roast for 45 minutes, until it reaches an internal temperature of 165\\u00baF.', 'While the meatloaf is roasting, work on the broccoli and cherry tomatoes: Trim the very end off of the broccoli stems with a peeler or a paring knife, removing the thick fibrous outer layer of the broccoli stems. Cut the broccoli lengthwise into large spears that look like long, skinny trees and place them along with the cherry tomatoes onto a sheet pan. Drizzle everything with EVOO and season with salt and freshly ground black pepper. Transfer to the oven during the last 30 minutes that the meatloaf is cooking.', 'For the gravy, place a medium-size saucepot over medium heat with the butter. Mash the whole roasted garlic cloves until they are nice and smooth, and add to the butter. Once the butter melts, whisk in flour and cook for 1 minute. Whisk in the chicken stock, then the milk. Allow the mixture to thicken, about 2 minutes, then stir in the Asiago cheese. Once the cheese has melted, season with salt and freshly ground black pepper.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 529.1, \"FatContent\": 16.7, \"SaturatedFatContent\": 9.2, \"CholesterolContent\": 194.1, \"SodiumContent\": 527.9, \"CarbohydrateContent\": 34.9, \"FiberContent\": 4.7, \"SugarContent\": 3.2, \"ProteinContent\": 60.2, \"source\": \"foodcom\", \"PrepTime\": \"PT30M\", \"CookTime\": \"PT45M\", \"TotalTime\": \"PT1H15M\", \"PrepTime_Minutes\": 30.0, \"CookTime_Minutes\": 45.0, \"TotalTime_Minutes\": 75.0, \"RecipeIngredientParts\": \"['garlic', 'garlic cloves', 'extra virgin olive oil', 'milk', 'poultry seasoning', 'fresh sage', 'nutmeg', 'shallots', 'parmigiano-reggiano cheese', 'egg', 'head broccoli', 'cherry tomatoes', 'butter', 'flour', 'milk', 'asiago cheese']\", \"RecipeIngredientParts_old\": \"['garlic', 'garlic cloves', 'extra virgin olive oil', 'milk', 'poultry seasoning', 'fresh sage', 'nutmeg', 'shallots', 'parmigiano-reggiano cheese', 'egg', 'head broccoli', 'cherry tomatoes', 'butter', 'flour', 'milk', 'asiago cheese']\", \"ingredients_canonical\": \"['garlic', 'olive oil', 'milk', 'poultry seasoning', 'sage', 'nutmeg', 'shallot', 'parmigiano reggiano cheese', 'egg', 'broccoli', 'cherry tomato', 'butter', 'flour', 'asiago cheese']\", \"ingredients_canonical_auto\": \"['garlic', 'olive oil', 'milk', 'poultry seasoning', 'sage', 'nutmeg', 'shallot', 'parmigiano reggiano cheese', 'egg', 'broccoli', 'cherry tomato', 'butter', 'flour', 'asiago cheese']\",
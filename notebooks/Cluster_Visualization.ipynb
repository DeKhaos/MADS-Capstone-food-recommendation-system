e, \"FSA_binned\": 2, \"popularity_log\": 4.2626798770413155, \"cluster\": \"0\", \"pca1\": -1.4073685648491856, \"pca2\": -0.2494903787644481, \"protein_kcal\": 16.4, \"fat_kcal\": 54.0, \"carb_kcal\": 52.0, \"protein_pct\": 13.398692810457517, \"fat_pct\": 44.11764705882353, \"net_carb_pct\": 42.48366013071895, \"satiety_score_raw\": 10.010053792097137, \"satiety\": 15.79411019918823, \"nutrient_density_raw\": 1.4429537400394203, \"nutrient_density\": 37.68823835971835}, {\"RecipeId\": 261826, \"Name\": \"Moroccan Lamb With Bean Mash\", \"RecipeInstructions\": \"['Place lamb in shallow bowl or glass baking dish; coat with 1 tablespoon oil. Add wine, orange juice, ginger, and orange peel to bowl. Mix to coat. Mix cumin, coriander, and cinnamon in small bowl. Sprinkle spice mixture over lamb, turning to coat evenly. Sprinkle with 2 tablespoons cilantro. Cover and marinate at room temperature 1 hour or chill up to 4 hours.', 'Preheat oven to 400\\u00b0F Heat 1 tablespoon oil in large ovenproof skillet over medium-high heat. Remove lamb from marinade, reserving marinade. Add lamb to skillet; sprinkle with salt and pepper. Cook until light brown, about 3 minutes per side. Push lamb to 1 side of skillet. Add onions and garlic to skillet; saut\\u00e9 until onions are light brown, about 3 minutes. Pour reserved marinade over lamb. Transfer to oven; roast until instant-read thermometer inserted into center registers 130\\u00b0F for medium-rare, about 15 minutes. Remove lamb from pan, reserving onions and garlic in skillet. Let lamb rest 5 minutes. Slice lamb, transfer to platter, and tent with foil to keep warm.', 'Place garbanzo beans and broth in medium saucepan; simmer over medium heat 10 minutes. Using slotted spoon, add onions and garlic from skillet to garbanzo bean mixture. Stir; simmer 5 minutes. Remove from heat; add 2 tablespoons cilantro. Using potato masher, mash to coarse puree. Season with salt and pepper.', 'Place scoop of garbanzo bean mash on each plate. Top with lamb slices. Drizzle with juices from skillet and serve.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 660.2, \"FatContent\": 35.2, \"SaturatedFatContent\": 13.3, \"CholesterolContent\": 115.0, \"SodiumContent\": 548.3, \"CarbohydrateContent\": 43.2, \"FiberContent\": 7.8, \"SugarContent\": 3.8, \"ProteinContent\": 38.9, \"source\": \"foodcom\", \"PrepTime\": \"PT20M\", \"CookTime\": \"PT1H30M\", \"TotalTime\": \"PT1H50M\", \"PrepTime_Minutes\": 20.0, \"CookTime_Minutes\": 90.0, \"TotalTime_Minutes\": 110.0, \"RecipeIngredientParts\": \"['boneless leg of lamb', 'olive oil', 'dry red wine', 'fresh ginger', 'ground cumin', 'ground coriander', 'ground cinnamon', 'fresh cilantro', 'red onions', 'garlic cloves', 'garbanzo beans', 'low sodium chicken broth']\", \"RecipeIngredientParts_old\": \"['boneless leg of lamb', 'olive oil', 'dry red wine', 'fresh ginger', 'ground cumin', 'ground coriander', 'ground cinnamon', 'fresh cilantro', 'red onions', 'garlic cloves', 'garbanzo beans', 'low sodium chicken broth']\", \"ingredients_canonical\": \"['lamb', 'olive oil', 'dry red wine', 'ginger', 'cumin', 'coriander', 'cinnamon', 'cilantro', 'onion', 'garlic', 'garbanzo bean', 'low sodium chicken broth']\", \"ingredients_canonical_auto\": \"['lamb', 'olive oil', 'dry red wine', 'ginger', 'cumin', 'coriander', 'cinnamon', 'cilantro', 'onion', 'garlic', 'garbanzo bean', 'low sodium chicken broth']\", \"ingredients_canonical_final\": \"['lamb', 'olive oil', 'dry red wine', 'ginger', 'cumin', 'coriander', 'cinnamon', 'cilantro', 'onion', 'garlic', 'garbanzo bean', 'low sodium chicken broth']\", \"ingredients_canonical_final_le_5_replace\": \"['lamb', 'olive oil', 'dry red wine', 'ginger', 'cumin', 'coriander', 'cinnamon', 'cilantro', 'onion', 'garlic', 'garbanzo bean', 'low sodium chicken broth']\", \"EnergyFromFat\": 316.8, \"EnergyFromSaturatedFat\": 119.7, \"EnergyFromCarbs\": 172.8, \"EnergyFromProtein\": 155.6, \"SaturatedFatPe
    {
      "id": "figuGuJyov8ayQp7is3Mk",
      "type": "text",
      "x": 8279.8912452759,
      "y": -2709.961994670695,
      "width": 931.5877685546875,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",

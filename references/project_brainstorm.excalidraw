    {
      "id": "NV4CgL6jN336lt2m5awZV",
      "type": "text",
      "x": 12526.413558536105,
      "y": -4093.337450421044,
      "width": 746.3677368164062,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],

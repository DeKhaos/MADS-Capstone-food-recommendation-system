nt\": false, \"WHO_Fat_Compliant\": false, \"WHO_Sodium_Compliant\": true, \"WHO_Score\": 1, \"WHO_Healthy\": false, \"Energy_kJ\": 786.592, \"A_score\": 10, \"C_score\": 2, \"FSA_Score\": 8, \"FSA_Healthy\": false, \"popularity_score\": 0.0, \"ID\": \"380193_foodcom\", \"WHO_binary\": false, \"FSA_binary\": false, \"FSA_binned\": 1, \"popularity_log\": 0.0, \"cluster\": \"0\", \"pca1\": -1.0971964635067415, \"pca2\": 0.3062341411833346, \"protein_kcal\": 7.2, \"fat_kcal\": 89.10000000000001, \"carb_kcal\": 96.4, \"protein_pct\": 3.7363777893098074, \"fat_pct\": 46.23767514270887, \"net_carb_pct\": 50.02594706798131, \"satiety_score_raw\": 2.6434946226823426, \"satiety\": 12.241033336904495, \"nutrient_density_raw\": -1.7759426373566685, \"nutrient_density\": 34.40673705780833}, {\"RecipeId\": 222983, \"Name\": \"Fresh Lemon Chiffon Cake\", \"RecipeInstructions\": \"['Have frosting ready and at the temperature you like to frost with.', 'Preheat oven to 320\\u00b0F.', 'Prepare cake pans: Coat bottoms of 3 (8-inch) round cake pans with cooking spray.  Do not coat sides of the cake pans.  Place wax paper on the bottom of the three cake pans and then spray the top of the wax paper with the cooking spray.  Dust the wax paper bottom of all three pans with 1 table spoon of flour.', 'Lightly spoon 2 cups cake flour into dry measuring cups, and level with a knife. Combine 2 cups cake flour, 1 cup sugar, baking powder, and \\u00bd teaspoon salt in a large bowl, stirring with a whisk until well combined.', 'Combine oil, 1/3 cups juice, 3 tablespoons water, 1 teaspoon rind, lemon extract, and egg yokes in a medium bowl, stirring with a whisk.  Add oil mixture to flour mixture; beat with mixer at medium speed until smooth.', 'Place egg whites in a large bowl; beat with mixer at high speed until foamy.  Add cream of tartar; beat until soft peaks form.  Gradually add remaining 1/4 cup sugar, 1 tablespoon at a time, beating until stiff peaks form.  Gently stir one-fourth of the egg white mixture into flour mixture; gently fold in remaining egg white mixture.', 'Divide cake batter equally among prepared pans, spreading evenly.  Break air pockets by cutting through batter with a knife. Bake at 325 degrees for 20 minuets or until cake springs back when lightly touched.  Cool in pans for 10 minuets on a wire rack; remove from pans. Remove wax paper from cake layers.  Cool completely on wire racks.', 'To assemble cake, place 1 cake layer on a plate; spread half of the filling over the cake layer. Top with second cake layer, remaining half of the filling, and third layer. Spread frosting over top and sides of cake.  Garnish with mint, blueberries, and lemon wedges, if desired.  Store cake loosely in refrigerator for up to three days.  Slice into cake wedges.']\", \"Images\": \"['https://img.sndimg.com/food/image/upload/w_555,h_416,c_fit,fl_progressive,q_95/v1/img/recipes/22/29/83/picRmbg9j.jpg', 'https://img.sndimg.com/food/image/upload/v1/img/feed/222983/2oUDuCjQvqltN5O45lch_D8CA8ABC-4DDD-47AF-94C2-A68D2A28FECC.jpeg']\", \"AggregatedRating_na\": 5.0, \"ReviewCount\": 4.0, \"Calories\": 265.3, \"FatContent\": 9.4, \"SaturatedFatContent\": 1.0, \"CholesterolContent\": 41.5, \"SodiumContent\": 211.9, \"CarbohydrateContent\": 40.4, \"FiberContent\": 0.4, \"SugarContent\": 21.2, \"ProteinContent\": 5.0, \"source\": \"foodcom\", \"PrepTime\": \"PT30M\", \"CookTime\": \"PT40M\", \"TotalTime\": \"PT1H10M\", \"PrepTime_Minutes\": 30.0, \"CookTime_Minutes\": 40.0, \"TotalTime_Minutes\": 70.0, \"RecipeIngredientParts\": \"['cake flour', 'cake flour', 'sugar', 'baking powder', 'salt', 'canola oil', 'fresh lemon juice', 'water', 'lemon rind', 'cream of tartar', 'mint sprig', 'lemon wedge', 'fresh blueberries']\", \"RecipeIngredientParts_old\": \"['cake flour', 'cake flour', 'sugar', 'baking powder', 'salt', 'canola oil', 'fresh lemon juice', 'water', 'lemon rind', 'cream of tartar', 'mint sprig', 'lemon wedge', 'fresh blueberries']\", \"ingredients_canonical\"
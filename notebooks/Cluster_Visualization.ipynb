    "\n",
    "import altair as alt\n",
    "import streamlit as st\n",
    "\n",
    "alt.data_transformers.disable_max_rows()\n",
    "st.set_page_config(layout=\"wide\", page_title=\"Recipe Nutrition Explorer\")\n",
    "\n",
    "def minmax_pct(series):\n",
    "    s = pd.to_numeric(series, errors=\"coerce\")\n",
    "    mn, mx = s.min(), s.max()\n",
    "    if pd.isna(mn) or pd.isna(mx) or mx == mn:\n",
    "        return pd.Series(np.nan, index=s.index)\n",
    "    return (s - mn) / (mx - mn) * 100\n",
    "\n",
    "def first_existing(df, candidates, default=None):\n",
    "    for c in candidates:\n",
    "        if c in df.columns:\n",
    "            return c\n",
    "    return default\n",
    "\n",
    "df = df_cluster.sample(n=20000, random_state=42).copy()\n",
    "\n",
    "recipe_col = first_existing(df, [\"Name\", \"recipe_name\", \"RecipeName\"], \"Name\")\n",
    "source_col = first_existing(df, [\"source\", \"Source\"], \"source\")\n",
    "category_col = first_existing(df, [\"RecipeCategory\", \"category\", \"Category\"], None)\n",
    "cluster_col = first_existing(df, [\"cluster\", \"Cluster\", \"kmeans_cluster\"], None)\n",
    "\n",
    "cal_col = first_existing(df, [\"Calories\"], \"Calories\")\n",
    "protein_col = first_existing(df, [\"ProteinContent\"], \"ProteinContent\")\n",
    "fat_col = first_existing(df, [\"FatContent\"], \"FatContent\")\n",
    "carb_col = first_existing(df, [\"CarbohydrateContent\"], \"CarbohydrateContent\")\n",
    "fiber_col = first_existing(df, [\"FiberContent\"], None)\n",
    "sugar_col = first_existing(df, [\"SugarContent\"], None)\n",
    "fsa_col = first_existing(df, [\"FSA_score\", \"fsa_score\", \"A_score\"], None)\n",
    "\n",
    "num_cols = [c for c in [cal_col, protein_col, fat_col, carb_col, fiber_col, sugar_col, fsa_col] if c is not None]\n",
    "for c in num_cols:\n",
    "    df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n",
    "\n",
    "if cluster_col:\n",
    "    df[cluster_col] = df[cluster_col].astype(str)\n",
    "\n",
    "required_cols = [cal_col, protein_col, fat_col, carb_col]\n",
    "if fsa_col:\n",
    "    required_cols.append(fsa_col)\n",
    "\n",
    "df = df.dropna(subset=required_cols).copy()\n",
    "df = df[df[cal_col] > 0].copy()\n",
    "\n",
    "# derived metrics\n",
    "df[\"protein_kcal\"] = df[protein_col] * 4\n",
    "df[\"fat_kcal\"] = df[fat_col] * 9\n",
    "df[\"carb_kcal\"] = df[carb_col] * 4\n",
    "\n",
    "total_macro_kcal = df[\"protein_kcal\"] + df[\"fat_kcal\"] + df[\"carb_kcal\"]\n",
    "total_macro_kcal = total_macro_kcal.replace(0, np.nan)\n",
    "\n",
    "df[\"protein_pct\"] = df[\"protein_kcal\"] / total_macro_kcal * 100\n",
    "df[\"fat_pct\"] = df[\"fat_kcal\"] / total_macro_kcal * 100\n",
    "df[\"net_carb_pct\"] = df[\"carb_kcal\"] / total_macro_kcal * 100\n",
    "\n",
    "fiber_term = df[fiber_col].fillna(0) * 2 if fiber_col else pd.Series(0, index=df.index)\n",
    "protein_term = df[\"protein_pct\"] * 0.8\n",
    "calorie_penalty = minmax_pct(df[cal_col]).fillna(0) * 0.4\n",
    "df[\"satiety_score_raw\"] = protein_term + fiber_term - calorie_penalty\n",
    "df[\"satiety\"] = minmax_pct(df[\"satiety_score_raw\"]).fillna(0)\n",
    "\n",
    "protein_scaled = minmax_pct(df[protein_col]).fillna(0)\n",
    "fiber_scaled = minmax_pct(df[fiber_col]).fillna(0) if fiber_col else pd.Series(0, index=df.index)\n",
    "fat_scaled = minmax_pct(df[fat_col]).fillna(0)\n",
    "sugar_scaled = minmax_pct(df[sugar_col]).fillna(0) if sugar_col else pd.Series(0, index=df.index)\n",
    "\n",
    "positive = protein_scaled * 0.45 + fiber_scaled * 0.35\n",
    "negative = fat_scaled * 0.20 + sugar_scaled * 0.25\n",
    "\n",
    "df[\"nutrient_density_raw\"] = positive - negative\n",
    "df[\"nutrient_density\"] = minmax_pct(df[\"nutrient_density_raw\"]).fillna(0)\n",
    "\n",
    "\n",
    "st.title(\"Health Exploration Dashboard\")\n",
    "st.caption(\"Interactive recipe scatterplot with satiety, nutrient density, cluster color, and FSA-size encoding\")\n",
    "\n",
    "\n",
    "# tabs/categories\n",
    "\n",
    "if category_col:\n",
    "    tabs = [\"all\"] + sorted(df[category_col].dropna().astype(str).unique().tolist())\n",
    "else:\n",
    "    tabs = [\"all\"]\n",
    "\n",
    "selected_tab = st.radio(\n",
    "    \"Category\",\n",
    "    tabs,\n",
    "    horizontal=True,\n",
    "    label_visibility=\"collapsed\"\n",
    ")\n",
    "\n",
    "plot_df = df.copy()\n",
    "if selected_tab != \"all\" and category_col:\n",
    "    plot_df = plot_df[plot_df[category_col].astype(str) == selected_tab].copy()\n",
    "\n",
    "# sidebar filters\n",
    "\n",
    "st.sidebar.header(\"Filters\")\n",
    "\n",
    "recipe_search = st.sidebar.text_input(\"Recipe\", \"\")\n",
    "source_search = st.sidebar.text_input(\"Source\", \"\")\n",
    "\n",
    "satiety_min, satiety_max = st.sidebar.slider(\"Satiety\", 0, 100, (0, 100))\n",
    "nutr_min, nutr_max = st.sidebar.slider(\"Nutrient density\", 0, 100, (0, 100))\n",
    "protein_min, protein_max = st.sidebar.slider(\"Protein (%)\", 0, 100, (0, 100))\n",
    "carb_min, carb_max = st.sidebar.slider(\"Net carbs (%)\", 0, 100, (0, 100))\n",
    "fat_min, fat_max = st.sidebar.slider(\"Fat (%)\", 0, 100, (0, 100))\n",
    "\n",
    "if cluster_col:\n",
    "    cluster_options = sorted(plot_df[cluster_col].dropna().astype(str).unique().tolist())\n",
    "    selected_clusters = st.sidebar.multiselect(\"Clusters\", cluster_options, default=cluster_options)\n",
    "else:\n",
    "    selected_clusters = None\n",
    "\n",
    "plot_df = plot_df[\n",
    "    plot_df[\"satiety\"].between(satiety_min, satiety_max) &\n",
    "    plot_df[\"nutrient_density\"].between(nutr_min, nutr_max) &\n",
    "    plot_df[\"protein_pct\"].between(protein_min, protein_max) &\n",
    "    plot_df[\"net_carb_pct\"].between(carb_min, carb_max) &\n",
    "    plot_df[\"fat_pct\"].between(fat_min, fat_max)\n",
    "].copy()\n",
    "\n",
    "if recipe_search:\n",
    "    plot_df = plot_df[\n",
    "        plot_df[recipe_col].astype(str).str.contains(recipe_search, case=False, na=False)\n",
    "    ]\n",
    "\n",
    "if source_col and source_search:\n",
    "    plot_df = plot_df[\n",
    "        plot_df[source_col].astype(str).str.contains(source_search, case=False, na=False)\n",
    "    ]\n",
    "\n",
    "if cluster_col and selected_clusters:\n",
    "    plot_df = plot_df[plot_df[cluster_col].astype(str).isin(selected_clusters)].copy()\n",
    "\n",
    "# optional display limit\n",
    "max_points = st.sidebar.slider(\"Max points to display\", 500, 10000, 3000, step=500)\n",
    "if len(plot_df) > max_points:\n",
    "    plot_df = plot_df.sample(max_points, random_state=42).copy()\n",
    "\n",
    "# labels for standout points\n",
    "\n",
    "label_df = pd.concat([\n",
    "    plot_df.nlargest(8, \"nutrient_density\"),\n",
    "    plot_df.nlargest(4, \"satiety\")\n",
    "], ignore_index=True)\n",
    "\n",
    "# summary metrics\n",
    "c1, c2, c3, c4 = st.columns(4)\n",
    "c1.metric(\"Recipes shown\", f\"{len(plot_df):,}\")\n",
    "c2.metric(\"Avg satiety\", f\"{plot_df['satiety'].mean():.1f}\" if len(plot_df) else \"NA\")\n",
    "c3.metric(\"Avg nutrient density\", f\"{plot_df['nutrient_density'].mean():.1f}\" if len(plot_df) else \"NA\")\n",
    "c4.metric(\"Avg FSA score\", f\"{plot_df[fsa_col].mean():.1f}\" if len(plot_df) and fsa_col else \"NA\")\n",
    "\n",
    "if len(plot_df) == 0:\n",
    "    st.warning(\"No recipes match the current filters.\")\n",
    "    st.stop()\n",
    "\n",
    "\n",
    "st.subheader(\"Satiety vs Nutrient Density\")\n",
    "\n",
    "size_choices = [c for c in [fsa_col, cal_col, protein_col, fat_col, carb_col] if c is not None]\n",
    "default_size_ix = 0 if fsa_col else 1 if len(size_choices) > 1 else 0\n",
    "\n",
    "size_metric = st.selectbox(\n",
    "    \"Point size\",\n",
    "    size_choices,\n",
    "    index=default_size_ix\n",
    ")\n",
    "\n",
    "tooltip_fields = [\n",
    "    alt.Tooltip(f\"{recipe_col}:N\", title=\"Recipe\"),\n",
    "    alt.Tooltip(\"satiety:Q\", title=\"Satiety\", format=\".1f\"),\n",
    "    alt.Tooltip(\"nutrient_density:Q\", title=\"Nutrient density\", format=\".1f\"),\n",
    "    alt.Tooltip(\"protein_pct:Q\", title=\"Protein %\", format=\".1f\"),\n",
    "    alt.Tooltip(\"net_carb_pct:Q\", title=\"Net carbs %\", format=\".1f\"),\n",
    "    alt.Tooltip(\"fat_pct:Q\", title=\"Fat %\", format=\".1f\"),\n",
    "    alt.Tooltip(f\"{cal_col}:Q\", title=\"Calories\", format=\".1f\"),\n",
    "    alt.Tooltip(f\"{protein_col}:Q\", title=\"Protein (g)\", format=\".1f\"),\n",
    "    alt.Tooltip(f\"{fat_col}:Q\", title=\"Fat (g)\", format=\".1f\"),\n",
    "    alt.Tooltip(f\"{carb_col}:Q\", title=\"Carbs (g)\", format=\".1f\"),\n",
    "]\n",
    "\n",
    "if fsa_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{fsa_col}:Q\", title=\"FSA Score\", format=\".2f\"))\n",
    "if cluster_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{cluster_col}:N\", title=\"Cluster\"))\n",
    "if source_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{source_col}:N\", title=\"Source\"))\n",
    "if category_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{category_col}:N\", title=\"Category\"))\n",
    "if fiber_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{fiber_col}:Q\", title=\"Fiber (g)\", format=\".1f\"))\n",
    "if sugar_col:\n",
    "    tooltip_fields.append(alt.Tooltip(f\"{sugar_col}:Q\", title=\"Sugar (g)\", format=\".1f\"))\n",
    "\n",
    "hover = alt.selection_point(on=\"mouseover\", fields=[recipe_col], empty=\"none\")\n",
    "\n",
    "base = alt.Chart(plot_df).encode(\n",
    "    x=alt.X(\"satiety:Q\", title=\"Satiety\", scale=alt.Scale(domain=[0, 100])),\n",
    "    y=alt.Y(\"nutrient_density:Q\", title=\"Nutrient Density\", scale=alt.Scale(domain=[0, 100])),\n",
    "    tooltip=tooltip_fields\n",
    ")\n",
    "\n",
    "if cluster_col:\n",
    "    points = base.mark_point(opacity=0.80, filled=True).encode(\n",
    "        size=alt.Size(\n",
    "            f\"{size_metric}:Q\",\n",
    "            title=\"FSA Score\" if size_metric == fsa_col else size_metric,\n",
    "            scale=alt.Scale(range=[30, 500])\n",
    "        ),\n",
    "        color=alt.Color(\n",
    "            f\"{cluster_col}:N\",\n",
    "            title=\"Cluster\",\n",
    "            scale=alt.Scale(scheme=\"category10\")\n",
    "        ),\n",
    "        shape=alt.Shape(\n",
    "            f\"{cluster_col}:N\",\n",
    "            title=\"Cluster\"\n",
    "        ),\n",
    "        stroke=alt.condition(hover, alt.value(\"black\"), alt.value(None)),\n",
    "        strokeWidth=alt.condition(hover, alt.value(1.5), alt.value(0))\n",
    "    ).add_params(hover)\n",
    "else:\n",
    "    points = base.mark_point(opacity=0.80, filled=True).encode(\n",
    "        size=alt.Size(\n",
    "            f\"{size_metric}:Q\",\n",
    "            title=\"FSA Score\" if size_metric == fsa_col else size_metric,\n",
    "            scale=alt.Scale(range=[30, 500])\n",
    "        ),\n",
    "        color=alt.Color(\n",
    "            \"satiety:Q\",\n",
    "            title=\"Satiety\",\n",
    "            scale=alt.Scale(scheme=\"tealblues\")\n",
    "        ),\n",
    "        stroke=alt.condition(hover, alt.value(\"black\"), alt.value(None)),\n",
    "        strokeWidth=alt.condition(hover, alt.value(1.5), alt.value(0))\n",
    "    ).add_params(hover)\n",
    "\n",
    "labels = alt.Chart(label_df).mark_text(\n",
    "    align=\"left\",\n",
    "    dx=7,\n",
    "    dy=-7,\n",
    "    fontSize=11\n",
    ").encode(\n",
    "    x=\"satiety:Q\",\n",
    "    y=\"nutrient_density:Q\",\n",
    "    text=alt.Text(f\"{recipe_col}:N\")\n",
    ")\n",
    "\n",
    "quadrant_vline = alt.Chart(pd.DataFrame({\"x\": [50]})).mark_rule(strokeDash=[4, 4]).encode(x=\"x:Q\")\n",
    "quadrant_hline = alt.Chart(pd.DataFrame({\"y\": [50]})).mark_rule(strokeDash=[4, 4]).encode(y=\"y:Q\")\n",
    "\n",
    "chart = (\n",
    "    quadrant_vline +\n",
    "    quadrant_hline +\n",
    "    points +\n",
    "    labels\n",
    ").properties(\n",
    "    width=950,\n",
    "    height=600\n",
    ").interactive()\n",
    "\n",
    "st.altair_chart(chart, use_container_width=True)\n",
    "\n",
    "left, right = st.columns(2)\n",
    "\n",
    "with left:\n",
    "    st.markdown(\"**Top by Nutrient Density**\")\n",
    "    show_cols = [recipe_col, \"nutrient_density\", \"satiety\", \"protein_pct\", \"net_carb_pct\", \"fat_pct\", cal_col]\n",
    "    if fsa_col:\n",
    "        show_cols.append(fsa_col)\n",
    "    if cluster_col:\n",
    "        show_cols.append(cluster_col)\n",
    "    if source_col:\n",
    "        show_cols.append(source_col)\n",
    "\n",
    "    st.dataframe(\n",
    "        plot_df.sort_values(\"nutrient_density\", ascending=False)[show_cols].head(15),\n",
    "        use_container_width=True\n",
    "    )\n",
    "\n",
    "with right:\n",
    "    st.markdown(\"**Top by Satiety**\")\n",
    "    show_cols2 = [recipe_col, \"satiety\", \"nutrient_density\", \"protein_pct\", \"net_carb_pct\", \"fat_pct\", cal_col]\n",
    "    if fsa_col:\n",
    "        show_cols2.append(fsa_col)\n",
    "    if cluster_col:\n",
    "        show_cols2.append(cluster_col)\n",
    "    if source_col:\n",
    "        show_cols2.append(source_col)\n",
    "\n",
    "    st.dataframe(\n",
    "        plot_df.sort_values(\"satiety\", ascending=False)[show_cols2].head(15),\n",
    "        use_container_width=True\n",
    "    )\n",
    "\n",
    "with st.expander(\"Show filtered data\"):\n",
    "    st.dataframe(plot_df, use_container_width=True)"
   ]
  },

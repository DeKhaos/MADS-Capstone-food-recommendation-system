tency.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 172.7, \"FatContent\": 13.1, \"SaturatedFatContent\": 5.2, \"CholesterolContent\": 26.4, \"SodiumContent\": 16.3, \"CarbohydrateContent\": 10.7, \"FiberContent\": 1.5, \"SugarContent\": 0.6, \"ProteinContent\": 4.3, \"source\": \"foodcom\", \"PrepTime\": \"PT10M\", \"CookTime\": \"PT30M\", \"TotalTime\": \"PT40M\", \"PrepTime_Minutes\": 10.0, \"CookTime_Minutes\": 30.0, \"TotalTime_Minutes\": 40.0, \"RecipeIngredientParts\": \"['plain flour', 'fresh ground white pepper']\", \"RecipeIngredientParts_old\": \"['plain flour', 'fresh ground white pepper']\", \"ingredients_canonical\": \"['plain flour', 'white pepper']\", \"ingredients_canonical_auto\": \"['plain flour', 'white pepper']\", \"ingredients_canonical_final\": \"['plain flour', 'white pepper']\", \"ingredients_canonical_final_le_5_replace\": \"['plain flour', 'white pepper']\", \"EnergyFromFat\": 117.9, \"EnergyFromSaturatedFat\": 46.8, \"EnergyFromCarbs\": 42.8, \"EnergyFromProtein\": 17.2, \"SaturatedFatPercentEnergy\": 27.09901563404749, \"FatPercentEnergy\": 68.26867400115808, \"WHO_SatFat_Compliant\": false, \"WHO_Fat_Compliant\": false, \"WHO_Sodium_Compliant\": true, \"WHO_Score\": 1, \"WHO_Healthy\": false, \"Energy_kJ\": 722.5767999999999, \"A_score\": 7, \"C_score\": 3, \"FSA_Score\": 4, \"FSA_Healthy\": false, \"popularity_score\": 0.0, \"ID\": \"425634_foodcom\", \"WHO_binary\": false, \"FSA_binary\": false, \"FSA_binned\": 2, \"popularity_log\": 0.0, \"cluster\": \"0\", \"pca1\": -1.0821340874632017, \"pca2\": -0.2671973389188382, \"protein_kcal\": 17.2, \"fat_kcal\": 117.89999999999999, \"carb_kcal\": 42.8, \"protein_pct\": 9.668353007307477, \"fat_pct\": 66.27318718381113, \"net_carb_pct\": 24.0584598088814, \"satiety_score_raw\": 8.585720256883834, \"satiety\": 15.107118292688249, \"nutrient_density_raw\": 0.9748601494911029, \"nutrient_density\": 37.211040728385264}, {\"RecipeId\": 252884, \"Name\
thy\": false, \"popularity_score\": 2.0, \"ID\": \"400980_foodcom\", \"WHO_binary\": false, \"FSA_binary\": false, \"FSA_binned\": 0, \"popularity_log\": 1.0986122886681098, \"cluster\": \"0\", \"pca1\": -0.9076406094945634, \"pca2\": 0.5614585248306516, \"protein_kcal\": 6.0, \"fat_kcal\": 119.7, \"carb_kcal\": 78.4, \"protein_pct\": 2.9397354238118565, \"fat_pct\": 58.64772170504654, \"net_carb_pct\": 38.412542871141596, \"satiety_score_raw\": 1.0300995015711738, \"satiety\": 11.462852269908876, \"nutrient_density_raw\": -3.4258658060587033, \"nutrient_density\": 32.72472422130719}, {\"RecipeId\": 396238, \"Name\": \"Sloppy Joes (+ 3 Variations)\", \"RecipeInstructions\": \"['Coat a large nonstick skillet with nonstick cooking spray; heat over medium-high heat. Crumble in the ground beef and cook, stirring occasionally, for 8 minutes.', 'Stir in the tomato sauce, ketchup, vinegar, worcestershire sauce and sugar. Simmer on medium-low for 10 minutes, stirring occasionally.', 'To serve, spoon about 1/2 cup of the mixture on each hamburger bun. Serve with pickles and coleslaw, if desired.', 'Variations:.', 'Asian: Add 2 cloves chopped garlic, 1/2 teaspoon ground ginger and substitute 2 tablespoons light soy sauce for Worcestershire sauce. Serve over white rice or on hamburger buns.', 'Italian: Add 1 teaspoon dried oregano and 1/2 teaspoon dried italian seasoning. Stir in marinara sauce instead of ketchup. Substitute prebaked pizza crust for hamburger buns and garnish with shredded mozzarella.', 'Mexican: Add 1 tablespoon chili powder and substitute prepared salsa for the ketchup. Serve in taco shells.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 352.0, \"FatContent\": 13.3, \"SaturatedFatContent\": 5.1, \"CholesterolContent\": 73.7, \"SodiumContent\": 656.6, \"CarbohydrateContent\": 29.4, \"FiberContent\": 1.5, \"SugarContent\": 9.0, \"ProteinContent\": 27.5, \"source\": \"foodcom\", \"PrepTime\": \"PT5M\", \"CookTime\": \"PT18M\", \"TotalTime\": \"PT23M\", \"PrepTime_Minutes\": 5.0, \"CookTime_Minutes\": 18.0, \"TotalTime_Minutes\": 23.0, \"RecipeIngredientParts\": \"['lean ground beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'Worcestershire sauce', 'sugar']\", \"RecipeIngredientParts_old\": \"['lean ground beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'Worcestershire sauce', 'sugar']\", \"ingredients_canonical\": \"['beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'worcestershire sauce', 'sugar']\", \"ingredients_canonical_auto\": \"['beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'worcestershire sauce', 'sugar']\", \"ingredients_canonical_final\": \"['beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'worcestershire sauce', 'sugar']\", \"ingredients_canonical_final_le_5_replace\": \"['beef', 'tomato sauce', 'ketchup', 'white wine vinegar', 'worcestershire sauce', 'sugar']\", \"EnergyFromFat\": 119.7, \"EnergyFromSaturatedFat\": 45.9, \"EnergyFromCarbs\": 117.6, \"EnergyFromProtein\": 110.0, \"SaturatedFatPercentEnergy\": 13.039772727272728, \"FatPercentEnergy\": 34.00568181818182, \"WHO_SatFat_Compliant\": false, \"WHO_Fat_Compliant\": false, \"WHO_Sodium_Compliant\": true, \"WHO_Score\": 1, \"WHO_Healthy\": false, \"Energy_kJ\": 1472.768, \"A_score\": 17, \"C_score\": 6, \"FSA_Score\": 11, \"FSA_Healthy\": false, \"popularity_score\": 0.0, \"ID\": \"396238_foodcom\", \"WHO_binary\": false, \"FSA_binary\": false, \"FSA_binned\": 0, \"popularity_log\": 0.0, \"cluster\": \"1\", \"pca1\": 0.11301977290712391, \"pca2\": -0.5912653912542788, \"protein_kcal\": 110.0, \"fat_kcal\": 119.7, \"carb_kcal\": 117.6, \"protein_pct\": 31.672905269219697, \"fat_pct\": 34.46587964295998, \"net_carb_pct\": 33.86121508782033, \"satiety_score_raw\": 23.884882919829202, \"satiety\": 22.48628943892975, \"nutrient_density_raw\": 12.938645430109704, \"nutrient_density\": 49.40751193193496}, {\"RecipeId\": 490348, \"Name\": \"Roasted Kabocha Squash and Celery Root Soup\", \"RecipeInstructions\": \"['Preheat the oven to 400\\u00b0F Cut the Kabocha squash in half with a very sharp knife, scrape out the seeds and strings, and place the halves cut-side down on a lightly oiled non-stick baking sheet. Peel the turnips and cut them in wedges. Peel the celery root and cut it in 1\\u201d pieces. Toss the turnips and celery root with about half a tablespoon of the olive oil and a pinch of sea salt, and spread them on another baking sheet.', 'Roast all the prepared vegetables in the hot oven for about 50 to 60 minutes, or until the squash gives easily when poked with a wooden spoon, and the turnips and celery root are tender and flecked with dark brown (note: I found the celery root/turnips were done faster, at about 30 minutes Check on them periodically.) When the squash is cool enough to handle, scoop it out of its shell.', 'While those vegetables are roasting, cut the leeks in half lengthwise, wash them thoroughly and slice thinly, using only the white and very light green parts. Set aside. Chop the onion and saut\\u00e9 it gently in the remaining tablespoon of olive oil, with a dash of salt and the rosemary, until it is soft and golden brown.', 'In a soup pot, combine the roasted squash, turnips, celery root, leeks and saut\\u00e9ed onions with 4 cups water and a teaspoon of salt. Simmer the vegetables, covered, about twenty minutes to let them get perfectly soft. Add two cups vegetable broth, two tablespoons fresh lemon juice, a pinch of hot paprika or cayenne and 3 tablespoons pure maple syrup.', 'Allow the soup to cool somewhat, then puree it in a blender or in the pot with an immersion blender. Add a little more vegetable broth if the soup is too thick to pour easily from a ladle. Return the soup to a clean pot and bring it back to a simmer.', 'In a small saucepan, melt the butter. Lower the heat and keep cooking the butter for a few minutes, stirring with a whisk, until it is a light golden brown. Stir the browned butter into the soup.', 'Taste the soup, and correct the seasoning, whisking in more salt, lemon juice, or maple syrup as needed. This last step is essential, as Kabocha squashes can vary in sweetness, and lemons certainly vary in acidity. And as always, when working on the sweet-sour balance you reach that point where only a good pinch of salt will make it right.', 'Drizzle a thin thread of olive oil on top of each serving of this soup, and then sprinkle it with a spoonful of toasted, chopped pecans.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 311.6, \"FatContent\": 19.4, \"SaturatedFatContent\": 5.0, \"CholesterolContent\": 15.3, \"SodiumContent\": 638.9, \"CarbohydrateContent\": 35.7, \"FiberContent\": 6.2, \"SugarContent\": 15.4, \"ProteinContent\": 4.4, \"source\": \"foodcom\", \"PrepTime\": \"PT20M\", \"CookTime\": \"PT1H30M\", \"TotalTime\": \"PT1H50M\", \"PrepTime_Minutes\": 20.0, \"CookTime_Minutes\": 90.0, \"TotalTime_Minutes\": 110.0, \"RecipeIngredientParts\": \"['turnips', 'turnips', 'celery root', 'celery root', 'olive oil', 'sea salt', 'leeks', 'leeks', 'yellow onion', 'rosemary', 'vegetable broth', 'fresh lemon juice', 'hot paprika', 'cayenne', 'pure maple syrup', 'unsalted butter', 'pecans', 'olive oil']\", \"RecipeIngredientParts_old\": \"['turnips', 'turnips', 'celery root', 'celery root', 'olive oil', 'sea salt', 'leeks', 'leeks', 'yellow onion', 'rosemary', 'vegetable broth', 'fresh lemon juice', 'hot paprika', 'cayenne', 'pure maple syrup', 'unsalted butter', 'pecans', 'olive oil']\", \"ingredients_canonical\": \"['turnip', 'celery root', 'olive oil', 'sea salt', 'leek', 'onion', 'rosemary', 'vegetable broth', 'lemon juice', 'paprika', 'cayenne', 'maple syrup', 'unsalted butter', 'pecan']\", \"ingredients_canonical_auto\": \"['turnip', 'celery root', 'olive oil', 'sea salt', 'leek', 'onion', 'rosemary', 'vegetable broth', 'lemon juice', 'paprika', 'cayenne', 'maple syrup', 'unsalted butter', 'pecan']\", \"ingredients_canonical_final\": \"['turnip', 'celery root', 'olive oil', 'sea salt', 'leek', 'onion', 'rosemary', 'vegetable broth', 'lemon juice', 'paprika', 'cayenne', 'maple syrup', 'unsalted butter', 'pecan']\", \"ingredients_canonical_final_le_5_replace\": \"['turnip', 'celery root', 'olive oil', 'sea salt', 'leek', 'onion', 'rosemary', 'vegetable broth', 'lemon juice', 'paprika', 'cayenne', 'maple syrup', 'unsalted butter', 'pecan']\", \"EnergyFromFat\": 174.6, \"EnergyFromSaturatedFat\": 45.0, \"EnergyFromCarbs\": 142.8, \"EnergyFromProtein\": 17.6, \"SaturatedFatPercentEnergy\": 14.441591784338897, \"FatPercentEnergy\": 56.03337612323491, \"WHO_SatFat_Compliant\": false, \"WHO_Fat_Compliant\": false, \"WHO_Sodium_Compliant\": true, \"WHO_Score\": 1, \"WHO_Healthy\": false, \"Energy_kJ\": 1303.7344, \"A_score\": 17, \"C_score\": 7, \"FSA_Score\": 10, \"FSA_Healthy\": false, \"popularity_score\": 0.0, \"ID\": \"490348_foodcom\", \"WHO_binary\": false, \"FSA_binary\": false, \"FSA_binned\": 1, \"popularity_log\": 0.0, \"cluster\": \"0\", \"pca1\": -0.43008517100643234, \"pca2\": 0.37679804811357803, \"protein_kcal\": 17.6, \"fat_kcal\": 174.6, \"carb_kcal\": 142.8, \"protein_pct\": 5.253731343283582, \"fat_pct\": 52.11940298507463, \"net_carb_pct\": 42.626865671641795, \"satiety_score_raw\": 12.668790614116615, \"satiety\": 17.076485873904986, \"nutrient_density_raw\": -0.16756770785981523, \"nutrient_density\": 36.04639357554093}, {\"RecipeId\": 11550, \"Name\": \"Ukrainian Perogies, for Beginners\", \"RecipeInstructions\": \"['Dough--------------.', 'Mix dough ingredients together.', 'You may have to add more liquid or flour to make the dough soft and somewhat sticky.', 'Turn onto a floured surface and knead more flour into dough- just enough to make it easier to handle.', 'The dough will be slightly sticky.', 'Do not over-knead.', 'Place dough in an oiled bowl.', 'Cover and let rest for 30 minuets.', 'Filling-----------.', 'Cook onion in butter.', 'Mix with potatoes, and add cheese while the mixture is still hot.', 'You may substitute Cheez Whiz for the cheddar.', 'Let filling cool before using (place in fridge.) If you are using the alternate filling, simply mix those ingredients together.', 'Manufacturing--------.', 'Set a large pot of water to boil.', 'Form walnut-sized balls of the filling.', 'Roll out dough on floured surface fairly thinly (3 millimeters, or 0.125 inch).', 'You will probably need to add flour as you roll.', 'Cut out circles approximately 7 1/2 centimeters (3 inches) in diameter (a wider-mouthed glass should do fine.) Press scraps into a ball.', 'Place filling ball in center of dough circle.', 'If the dough has a less-floury side, keep that side up.', 'Fold dough over ball, and pinch edges to form a half circle.', 'To prevent perogies with\\\\\\\\', ', I pinch at the top (\\\\\\\\', ') of the perogy first, then pinch at the 180 and  degree edges, working up to the 90 degree mark.', 'You can cheat pinching the perogies by smearing water on the filling side of the dough at the edges, and keep your fingers floured when you pinch (on the non-filling side.) In order to prevent perogies from drying out, keep finished perogies on a floured surface, and cover with a floured clean dishcloth.', 'Place several perogies in boiling water.', 'Stir once, gently with a slotted spoon.', 'Perogies are done when they float for a minute (this will take 2-3 minutes).', 'Melt about 1/2 cup of butter or margarine in microwave.', 'Rescue and drain the perogies with the slotted spoon.', 'Place in a bowl, drizzle with some melted butter, and gently shake to distribute the butter.', 'Cook, drain, and drizzle the other perogies in the same manner.', '*Platzkies (pronounced \\\\\\\\', '): (The scrap dough is not tender enough to make into perogies, but make good\\\\\\\\', ' by themselves.) Roll out scraps to approxamitely the same thickness as before.', 'Add minimal flour, and handle dough as little as possible.', 'Try to keep edges even.', 'Cut dough with a knife into strips about 8 cm (3 inches) wide.', 'Cut each strip into several triangles and/or squares.', 'Cook strips in water until they float.', 'Repeat draining and drizzling treatment as with perogies.']\", \"Images\": \"['https://img.sndimg.com/food/image/upload/w_555,h_416,c_fit,fl_progressive,q_95/v1/img/recipes/11/55/0/picP4KoW8.jpg', 'https://img.sndimg.com/food/image/upload/w_555,h_416,c_fit,fl_progressive,q_95/v1/img/recipes/11/55/0/xHV5owMURid3heN2W50K_20180702_221229.jpg', 'https://img.sndimg.com/food/image/upload/w_555,h_416,c_fit,fl_progressive,q_95/v1/img/recipes/11/55/0/pic9UtfTA.jpg', 'https://img.sndimg.com/food/image/upload/w_555,h_416,c_fit,fl_progressive,q_95/v1/img/recipes/11/55/0/picba9McB.jpg']\", \"AggregatedRating_na\": 5.0, \"ReviewCount\": 28.0, \"Calories\": 49.8, \"FatContent\": 2.2, \"SaturatedFatContent\": 1.2, \"CholesterolContent\": 5.4, \"SodiumContent\": 73.5, \"CarbohydrateContent\": 6.1, \"FiberContent\": 0.4, \"SugarContent\": 0.2, \"ProteinContent\": 1.4, \"source\": \"foodcom\", \"PrepTime\": \"PT30M\", \"CookTime\": \"PT2M\", \"TotalTime\": \"PT32M\", \"PrepTime_Minutes\": 30.0, \"CookTime_Minutes\": 2.0, \"TotalTime_Minutes\": 32.0, \"RecipeIngredientParts\": \"['flour', 'milk', 'potato', 'salt', 'onion', 'butter', 'potatoes', 'cheddar cheese', 'cottage cheese', 'fresh dill', 'egg']\", \"RecipeIngredientParts_old\": \"['flour', 'milk', 'potato', 'salt', 'onion', 'butter', 'potatoes', 'cheddar cheese', 'cottage cheese', 'fresh dill', 'egg']\", \"ingredients_canonical\": \"['flour', 'milk', 'potato', 'salt', 'onion', 'butter', 'cheddar cheese', 'cottage cheese', 'dill', 'egg']\", \"ingredients_canonical_auto\": \"['flour', 'milk', 'potato', 'salt', 'onion', 'butter', 'cheddar cheese', 'cottage cheese', 'dill', 'egg']\", \"ingredients_canonical_final\": \"['flour', 'milk', 'potato', 'salt', 'onion', 'butter', 'cheddar cheese', 'cottage cheese', 'dill', 'egg']\", \"ingredients_canonical_final_le_5_
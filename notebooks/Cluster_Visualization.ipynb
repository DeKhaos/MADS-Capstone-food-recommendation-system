wn.', 'Spoon about 1/3 of the onion mixture onto the under side of the chicken and spread it out evenly.', 'Turn the chicken over.', 'Lift the skin of the chicken and spoon in the remainder of the onion mixture. again try to even out the onion distribution as much as possible.', 'Pour some water in the base of the roasting pan to prevent the chicken from drying. (you may add more later if you feel the chicken needs it).', 'Place the chicken in the oven for 90 minutes or until golden brown all over and the juices run clear.', 'Once the chicken is cooked all the way through allow it to rest for 15 minutes before serving.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 5.0, \"ReviewCount\": 1.0, \"Calories\": 193.1, \"FatContent\": 11.8, \"SaturatedFatContent\": 3.4, \"CholesterolContent\": 53.5, \"SodiumContent\": 3543.4, \"CarbohydrateContent\": 5.8, \"FiberContent\": 1.5, \"SugarContent\": 1.9, \"ProteinContent\": 13.2, \"source\": \"foodcom\", \"PrepTime\": \"PT15M\", \"CookTime\": \"PT1H30M\", \"TotalTime\": \"PT1H45M\", \"PrepTime_Minutes\": 15.0, \"CookTime_Minutes\": 90.0, \"TotalTime_Minutes\": 105.0, \"RecipeIngredientParts\": \"['roasting chicken', 'salt', 'black pepper', 'dried thyme', 'onion', 'white vinegar', 'water']\", \"RecipeIngredientParts_old\": \"['roasting chicken', 'salt', 'black pepper', 'dried thyme', 'onion', 'white vinegar', 'water']\", \"ingredients_canonical\": \"['chicken', 'salt', 'black pepper', 'thyme', 'onion', 'white vinegar', 'water']\", \"ingredients_canonical_auto\": \"['chicken', 'salt', 'black pepper', 'thyme', 'onion', 'white vinegar', 'water']\", \"ingredients_canonical_final\": \"['chicken', 'salt', 'black pepper', 'thyme', 'onion', 'white vinegar', 'water']\", \"ingredients_canonical_final_le_5_replace\": \"['chicken', 'salt', 'black pepper', 'thyme', 'onion', 'white vinegar', 'water']\", \"EnergyFromFat\": 106.2, \"EnergyFromSaturatedFat\": 30.6, \"EnergyFromCarbs\": 23.2, \"EnergyFromProtein\": 52.8, \"SaturatedFatPercent
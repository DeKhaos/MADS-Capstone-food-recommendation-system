e of crusty bread.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 0.0, \"ReviewCount\": 0.0, \"Calories\": 299.8, \"FatContent\": 14.7, \"SaturatedFatContent\": 2.4, \"CholesterolContent\": 17.9, \"SodiumContent\": 722.0, \"CarbohydrateContent\": 33.2, \"FiberContent\": 9.2, \"SugarContent\": 12.3, \"ProteinContent\": 11.6, \"source\": \"foodcom\", \"PrepTime\": \"PT20M\", \"CookTime\": \"PT1H\", \"TotalTime\": \"PT1H20M\", \"PrepTime_Minutes\": 20.0, \"CookTime_Minutes\": 60.0, \"TotalTime_Minutes\": 80.0, \"RecipeIngredientParts\": \"['sweet potato', 'baby potatoes', 'turnip', 'parsnip', 'carrot', 'broccoli floret', 'cauliflower floret', 'Brussels sprout', 'eggplant', 'celery ribs', 'asparagus spear', 'zucchini', 'red onion', 'garlic cloves', 'olive oil', 'dried basil', 'dried thyme', 'dried oregano', 'fresh coarse ground black pepper', 'broth']\", \"RecipeIngredientParts_old\": \"['sweet potato', 'baby potatoes', 'turnip', 'parsnip', 'carrot', 'broccoli floret', 'cauliflower floret', 'Brussels sprout', 'eggplant', 'celery ribs', 'asparagus spear', 'zucchini', 'red onion', 'garlic cloves', 'olive oil', 'dried basil', 'dried thyme', 'dried oregano', 'fresh coarse ground black pepper', 'broth']\", \"ingredients_canonical\": \"['sweet potato', 'potato', 'turnip', 'parsnip', 'carrot', 'broccoli floret', 'cauliflower floret', 'brussels sprout', 'eggplant', 'celery rib', 'asparagus spear', 'zucchini', 'onion', 'garlic', 'olive oil', 'basil', 'thyme', 'oregano', 'coarse black pepper', 'broth']\", \"ingredients_canonical_auto\": \"['sweet potato', 'potato', 'turnip', 'parsnip', 'carrot', 'broccoli floret', 'bean sprout', 'eggplant', 'celery rib', 'asparagus spear', 'zucchini', 'onion', 'garlic', 'olive oil', 'basil', 'thyme', 'oregano', 'coarse black pepper', 'broth']\", \"ingredients_canonical_final\": \"['sweet potato', 'potato', 'turnip', 'parsnip', 'carrot', 'broccoli floret', 'bean sprout', 'eggplant', 'celery rib', 'asparagus spear', 'zucchini', 'onion', 'garlic'
      "seed": 1911270856,
      "version": 4733,
      "versionNonce": 1382456776,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1772502236124,
      "link": null,
      "locked": false,
      "text": "- Explore which items are usually bought together (frequent\nitemsets) -> so when user search for something like pasta, we might\nprioritize tomato-based recipes because they are likely to have\nbought tomato. \n\n- From the grocery list and frequent itemsets set, we might be to\nbuild some kind of predefined recipe ranking based on grocery list\nalone. \n\n...",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "J37mySQc0_9lH55cQ4NYm",
      "originalText": "- Explore which items are usually bought together (frequent itemsets) -> so when user search for something like pasta, we might prioritize tomato-based recipes because they are likely to have bought tomato. \n\n- From the grocery list and frequent itemsets set, we might be to build some kind of predefined recipe ranking based on grocery list alone. \n\n...",
      "autoResize": true,
      "lineHeight": 1.25
    },

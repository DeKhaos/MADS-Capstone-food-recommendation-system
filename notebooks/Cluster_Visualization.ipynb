 the water from 3 cups to 1/2 cup.']\", \"Images\": \"[]\", \"AggregatedRating_na\": 4.0, \"ReviewCount\": 1.0, \"Calories\": 146.2, \"FatContent\": 1.2, \"SaturatedFatContent\": 0.2, \"CholesterolContent\": 0.0, \"SodiumContent\": 8.4, \"CarbohydrateContent\": 30.1, \"FiberContent\": 2.3, \"SugarContent\": 2.6, \"ProteinContent\": 4.9, \"source\": \"foodcom\", \"PrepTime\": \"PT20M\", \"CookTime\": \"PT2H\", \"TotalTime\": \"PT2H20M\", \"PrepTime_Minutes\": 20.0, \"CookTime_Minutes\": 120.0, \"TotalTime_Minutes\": 140.0, \"RecipeIngredientParts\": \"['brown rice', 'olive oil flavored cooking spray', 'yellow onion', 'green bell pepper', 'garlic cloves', 'bay leaf', 'tomatoes', 'sea salt', 'pepper', 'fresh cilantro']\", \"RecipeIngredientParts_old\": \"['brown rice', 'olive oil flavored cooking spray', 'yellow onion', 'green bell pepper', 'garlic cloves', 'bay leaf', 'tomatoes', 'sea salt', 'pepper', 'fresh cilantro']\", \"ingredients_canonical\": \"['brown rice', 'olive oil flavored cooking spray', 'onion', 'green bell pepper', 'garlic', 'bay leaf', 'tomato', 'sea salt', 'pepper', 'cilantro']\", \"ingredients_canonical_auto\": \"['brown rice', 'olive oil flavored cooking spray', 'onion', 'green bell pepper', 'garlic', 'bay leaf', 'tomato', 'sea salt', 'pepper', 'cilantro']\", \"ingredients_canonical_final\": \"['brown rice', 'olive oil flavored cooking spray', 'onion', 'green bell pepper', 'garlic', 'bay leaf', 'tomato', 'sea salt', 'pepper', 'cilantro']\", \"ingredients_canonical_final_le_5_replace\": \"['brown rice', 'olive oil flavored cooking spray', 'onion', 'green bell pepper', 'garlic', 'bay leaf', 'tomato', 'sea salt', 'pepper', 'cilantro']\", \"EnergyFromFat\": 10.8, \"EnergyFromSaturatedFat\": 1.8, \"EnergyFromCarbs\": 120.4, \"EnergyFromProtein\": 19.6, \"SaturatedFatPercentEnergy\": 1.2311901504787963, \"FatPercentEnergy\": 7.387140902872777, \"WHO_SatFat_Compliant\": true, \"WHO_Fat_Compliant\": true, \"WHO_Sodium_Compliant\": true, \"WHO_Score\": 3, \"